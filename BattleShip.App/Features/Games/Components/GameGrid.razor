<table class="game-grid" aria-label="@Title" @onmouseleave="ClearPreview">
    <caption class="sr-only">@Title. Lignes A à J, colonnes 1 à 10.</caption>
    <thead>
        <tr>
            <td></td>
            @for (var column = 1; column <= Board.Size; column++)
            {
                <th scope="col">@column</th>
            }
        </tr>
    </thead>
    <tbody>
        @for (var row = 0; row < Board.Size; row++)
        {
            <tr>
                <th scope="row">@((char)('A' + row))</th>
                @for (var column = 0; column < Board.Size; column++)
                {
                    var cell = Cells[row * Board.Size + column];
                    var position = new Position(cell.Row, cell.Column);
                    var classes = $"cell cell-{cell.State.ToString().ToLowerInvariant()} {(LastShot == position || LastTargets.Contains(position) ? "last-shot" : "")} {PreviewClass(position)}";
                    <td @onmouseenter="() => Preview(position)">
                        @if (IsOpponent || SelectedAction == GameAction.Mine)
                        {
                            <button type="button" class="@classes" aria-label="@Label(cell)" title="@Label(cell)"
                                    disabled="@(!CanTarget(position))" @onfocus="() => Preview(position)" @onblur="ClearPreview"
                                    @onclick="() => Select(position)">
                                <span aria-hidden="true">@Symbol(cell.State)</span>
                                @if (cell.HasMine)
                                {
                                    <span class="mine-marker" aria-hidden="true">M</span>
                                }
                            </button>
                        }
                        else
                        {
                            <span class="@classes" title="@Label(cell)">
                                <span aria-hidden="true">@Symbol(cell.State)</span>
                                <span class="sr-only">@Label(cell)</span>
                                @if (cell.HasMine)
                                {
                                    <span class="mine-marker" aria-hidden="true">M</span>
                                }
                            </span>
                        }
                    </td>
                }
            </tr>
        }
    </tbody>
</table>
<p class="target-hint" aria-live="polite">@PreviewText</p>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<CellDto> Cells { get; set; } = [];
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public bool IsOpponent { get; set; }
    [Parameter] public bool CanFire { get; set; }
    [Parameter] public GameAction SelectedAction { get; set; }
    [Parameter] public Position? LastShot { get; set; }
    [Parameter] public IReadOnlyList<Position> LastTargets { get; set; } = [];
    [Parameter] public EventCallback<Position> OnSelect { get; set; }

    private Position? previewAnchor;
    private GameAction previousAction;
    private bool IsTargetGrid => IsOpponent ? SelectedAction != GameAction.Mine : SelectedAction == GameAction.Mine;
    private CellDto CellAt(Position position) => Cells[position.Row * Board.Size + position.Column];
    private bool IsFresh(Position position) => SelectedAction == GameAction.Mine
        ? CellAt(position) is { HasMine: false, State: CellState.Water or CellState.Ship }
        : CellAt(position).State == CellState.Unknown;

    private bool CanTarget(Position position) => CanFire && IsTargetGrid
        && PowerRules.Targets(SelectedAction, position).Any(IsFresh);

    protected override void OnParametersSet()
    {
        if (SelectedAction != previousAction || !CanFire)
            previewAnchor = null;
        previousAction = SelectedAction;
    }

    private void Preview(Position position) => previewAnchor = CanFire && IsTargetGrid ? position : null;
    private void ClearPreview() => previewAnchor = null;
    private async Task Select(Position position)
    {
        if (!CanTarget(position))
            return;
        ClearPreview();
        await OnSelect.InvokeAsync(position);
    }

    private string PreviewClass(Position position)
    {
        if (previewAnchor is not { } anchor || !CanFire || !IsTargetGrid)
            return "";
        var targets = PowerRules.Targets(SelectedAction, anchor);
        if (targets.Length == 0)
            return position == anchor ? "target-invalid" : "";
        if (!targets.Contains(position))
            return "";
        return !CanTarget(anchor) ? "target-invalid" : IsFresh(position) ? "target-preview" : "target-known";
    }

    private string PreviewText => previewAnchor is not { } anchor ? ""
        : !CanTarget(anchor) ? "Cible indisponible : zone hors grille ou cases déjà utilisées."
        : SelectedAction == GameAction.Mine ? "Une mine sera posée sur cette case."
        : $"{PowerRules.Targets(SelectedAction, anchor).Count(IsFresh)} case(s) seront visées ; les cases déjà jouées sont ignorées.";

    private static string Symbol(CellState state) => state switch
    {
        CellState.Ship => "#",
        CellState.Miss => "·",
        CellState.Hit or CellState.Sunk => "×",
        _ => ""
    };

    private static string Label(CellDto cell) => $"{(char)('A' + cell.Row)}{cell.Column + 1} : {cell.State switch
    {
        CellState.Unknown => "non explorée",
        CellState.Water => "eau",
        CellState.Ship => "navire",
        CellState.Miss => "à l’eau",
        CellState.Hit => "touché",
        CellState.Sunk => "coulé",
        _ => "inconnu"
    }}{(cell.HasMine ? ", mine armée" : "")}";
}
