<section class="panel game-history" aria-labelledby="game-history-title">
    <div class="history-heading">
        <div><p class="eyebrow">JOURNAL DE BORD</p><h2 id="game-history-title">Historique des parties</h2></div>
        <span class="history-count">@Entries.Count / @GameHistoryStore.Capacity</span>
    </div>
    <p class="history-note">Les 50 dernières parties sont conservées dans ce navigateur. Une fois l’application chargée, les archives restent consultables sans connexion à l’API.
        « Reprendre » nécessite une partie encore disponible sur le serveur.</p>
    @if (Entries.Count == 0)
    {
        <p class="history-note">Aucune partie enregistrée. Votre prochaine partie apparaîtra ici automatiquement.</p>
    }
    else
    {
        <div class="history-scroll" tabindex="0" role="region" aria-label="Liste des parties enregistrées">
            <table class="history-table games-table" aria-label="Parties enregistrées">
                <thead><tr><th scope="col">Début</th><th scope="col">Joueur</th><th scope="col">Dernier résultat connu</th><th scope="col">Tours</th><th scope="col">Actions</th></tr></thead>
                <tbody>
                    @foreach (var entry in Entries)
                    {
                        <tr @key="entry.State.Id" data-game-id="@entry.State.Id">
                            <td><time datetime="@entry.State.CreatedAtUtc.ToString("O")">@DateText(entry.State.CreatedAtUtc)</time></td>
                            <th scope="row">@entry.State.PlayerName</th>
                            <td>@StatusText(entry.State.Status) @(entry.State.Id == ActiveGameId ? "· Affichée" : "")</td>
                            <td>@entry.State.TurnNumber</td>
                            <td class="history-actions">
                                <button type="button" class="secondary" aria-expanded="@(selectedId == entry.State.Id ? "true" : "false")"
                                        aria-controls="archived-game-detail" @onclick="() => selectedId = entry.State.Id">Consulter</button>
                                @if (entry.State.Status == GameStatus.InProgress && entry.State.Id != ActiveGameId)
                                {
                                    <button type="button" class="secondary" disabled="@Disabled" @onclick="() => OnResume.InvokeAsync(entry.State.Id)">Reprendre</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    <div id="archived-game-detail">
        @if (Selected is { } selected)
        {
            <div class="archive-heading">
                <div>
                    <h3>@selected.State.PlayerName · @StatusText(selected.State.Status)</h3>
                    <p class="history-note">Partie du @DateText(selected.State.CreatedAtUtc) · Archive mise à jour le @DateText(selected.SavedAtUtc).</p>
                </div>
                <button type="button" class="secondary" @onclick="() => selectedId = null">Fermer le détail</button>
            </div>
            <TurnHistory Turns="selected.State.Turns" Title="Tirs de la partie archivée" />
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<GameHistoryEntry> Entries { get; set; } = [];
    [Parameter] public Guid? ActiveGameId { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<Guid> OnResume { get; set; }

    private Guid? selectedId;
    private GameHistoryEntry? Selected => Entries.FirstOrDefault(entry => entry.State.Id == selectedId);
    private static string DateText(DateTimeOffset date) => date.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss");
    private static string StatusText(GameStatus status) => status switch
    {
        GameStatus.PlayerWon => "Victoire",
        GameStatus.ComputerWon => "Défaite",
        _ => "En cours"
    };
}
